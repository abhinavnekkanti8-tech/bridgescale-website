  reason         String            @db.Text
  refundAmount   Int?
  payoutPenalty  Int?
  metadata       Json?
  createdAt      DateTime          @default(now())

  sow StatementOfWork @relation(fields: [sowId], references: [id], onDelete: Cascade)

  @@index([sowId])
  @@map("cancellation_events")
}

model EngagementCall {
  id               String               @id @default(cuid())
  startupProfileId String
  operatorId       String
  shortlistId      String?
  candidateId      String?
  requestedBy      String
  status           EngagementCallStatus @default(REQUESTED)
  proposedAt       DateTime?
  scheduledAt      DateTime?
