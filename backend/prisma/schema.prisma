// ─────────────────────────────────────────────
// ENGAGEMENT WORKSPACE MODELS (Artifact 9)
// ─────────────────────────────────────────────

enum EngagementStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  TERMINATED
  CONVERTED_TO_FULLTIME
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

model Engagement {
  id              String           @id @default(cuid())
  contractId      String           @unique
  startupId       String
  operatorId      String
  status          EngagementStatus @default(NOT_STARTED)
  startDate       DateTime?
  endDate         DateTime?
  healthScore     Int              @default(100)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  contract   Contract         @relation(fields: [contractId], references: [id])
  startup    StartupProfile   @relation(fields: [startupId], references: [id])
  operator   OperatorProfile  @relation(fields: [operatorId], references: [id])
  milestones EngagementMilestone[]
  notes      WorkspaceNote[]
  logs            ActivityLog[]
  healthSnapshots HealthScoreSnapshot[]
  nudges          SystemNudge[]
  escalations     EscalationCase[]
  closeoutReport  CloseoutReport?
  ratings         EngagementRating[]
  renewalRec      RenewalRecommendation?
  lifecycleEvents LifecycleEvent[]

  @@index([startupId])
  @@index([operatorId])
  @@map("engagements")
}

model LifecycleEvent {
  id           String             @id @default(cuid())
  engagementId String
  eventType    LifecycleEventType
  description  String             @db.Text
  metadata     Json?
  createdAt    DateTime           @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@index([eventType])
  @@map("lifecycle_events")
}

model EngagementMilestone {
  id            String          @id @default(cuid())
  engagementId  String
  title         String
  description   String          @db.Text
  dueDate       DateTime
  status        MilestoneStatus @default(PENDING)
  completedAt   DateTime?
  evidenceUrl   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@map("engagement_milestones")
}

model WorkspaceNote {
  id            String     @id @default(cuid())
  engagementId  String
  authorId      String
  content       String     @db.Text
  isPinned      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id])

  @@index([engagementId])
  @@map("workspace_notes")
}

model ActivityLog {
  id            String     @id @default(cuid())
  engagementId  String
  actorId       String
  actionType    String     // e.g. "MILESTONE_COMPLETED", "FILE_UPLOADED"
  description   String
  metadata      Json?
  createdAt     DateTime   @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id])

  @@index([engagementId])
  @@map("activity_logs")
}

// ─────────────────────────────────────────────
// HEALTH, NUDGES & ESCALATIONS (Artifact 10)
// ─────────────────────────────────────────────

model HealthScoreSnapshot {
  id              String     @id @default(cuid())
  engagementId    String
  scoreTotal      Int
  components      Json       // e.g. { milestonePace: 20, communicationFreq: 25, paymentStatus: 30, ... }
  aiCommentary    String?    @db.Text
  suggestedAction String?    @db.Text
  createdAt       DateTime   @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@map("health_score_snapshots")
}

enum NudgeType {
  MILESTONE_DUE_SOON
  MILESTONE_OVERDUE
  INACTIVITY_WARNING
  PAYMENT_REMINDER
  MEETING_PREP
}

model SystemNudge {
  id           String     @id @default(cuid())
  engagementId String
  targetUserId String
  nudgeType    NudgeType
  message      String
  isRead       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  targetUser User       @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@index([targetUserId])
  @@map("system_nudges")
}

enum EscalationStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model EscalationCase {
  id              String           @id @default(cuid())
  engagementId    String
  reporterId      String
  reason          String           @db.Text
  status          EscalationStatus @default(OPEN)
  resolutionNotes String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  reporter   User       @relation(fields: [reporterId], references: [id])

  @@index([engagementId])
  @@map("escalation_cases")
}

// ─────────────────────────────────────────────
// CLOSEOUT, RATINGS & RENEWALS (Artifact 11)
// ─────────────────────────────────────────────

enum CloseoutStatus {
  DRAFT
  PUBLISHED
}

model CloseoutReport {
  id              String         @id @default(cuid())
  engagementId    String         @unique
  summary         String         @db.Text
  outcomes        String         @db.Text
  nextSteps       String         @db.Text
  generatedByAi   Boolean        @default(true)
  promptVersion   String?
  status          CloseoutStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("closeout_reports")
}

model EngagementRating {
  id              String   @id @default(cuid())
  engagementId    String
  reviewerId      String
  revieweeId      String
  score           Int      // 1 to 5
  components      Json?    // Any sub-scores or categorical ratings
  comments        String?  @db.Text
  createdAt       DateTime @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  reviewer   User       @relation("RatingReviewer", fields: [reviewerId], references: [id])
  reviewee   User       @relation("RatingReviewee", fields: [revieweeId], references: [id])

  @@index([engagementId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@map("engagement_ratings")
}

enum RenewalType {
  RENEWAL
  RETAINER_CONVERSION
  FOLLOW_ON_SPRINT
  NONE
}

model RenewalRecommendation {
  id              String      @id @default(cuid())
  engagementId    String      @unique
  recommendedType RenewalType
  reasoning       String      @db.Text
  createdAt       DateTime    @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@map("renewal_recommendations")
}

// ─────────────────────────────────────────────
// AI WORKFLOWS, PAYMENTS & SOW TEMPLATES
// ─────────────────────────────────────────────

enum PaymentProvider {
  RAZORPAY
  STRIPE
  DUMMY
}

enum EmploymentStatus {
  EMPLOYED_FULL_TIME
  FREELANCE
  BETWEEN_ROLES
  OTHER
}

enum SeniorityLevel {
  IC
  MANAGER
  DIRECTOR
  VP
  C_SUITE
}

enum AvailabilityHours {
  H5_10
  H10_20
  H20_30
  FULL_FRACTIONAL
}

enum DiagnosisStatus {
  DRAFT_AI
  UNDER_REVIEW
  READY_FOR_CLIENT
  APPROVED
  REVISION_REQUESTED
}

enum PreScreenRecommendation {
  STRONG_PASS
  PASS
  CONDITIONAL
  FAIL
}

enum SowTemplateType {
  PIPELINE_SPRINT
  BD_SPRINT
  FRACTIONAL_RETAINER
  MARKET_ENTRY
  HYBRID_EQUITY
}

enum EquityType {
  FAST    // Future Equity (FAST agreement — no cap table change until next round)
  DIRECT  // Direct equity issuance (requires articles amendment)
}

enum EquityGrantStatus {
  PENDING       // Contract signed; vesting not yet started
  ACTIVE        // Vesting in progress
  FULLY_VESTED  // All equity vested
  LAPSED        // Engagement terminated before full vest; unvested lapses
  ACCELERATED   // Full vest triggered early (acquisition, IPO)
}

// ── Early-Access Applications ──────────────────────────────────────

enum ApplicationType {
  COMPANY
  TALENT
}

enum ApplicationStatus {
  // ── Active statuses ────────────────────────────────────────────────────
  EMAIL_VERIFICATION_PENDING
  PENDING_PAYMENT
  PAYMENT_FAILED
  SUBMITTED
  AWAITING_COMPLETION    // Talent account created but refs/assessment incomplete
  UNDER_REVIEW
  // Company workflow
  DIAGNOSIS_GENERATED
  DIAGNOSIS_UNDER_REVIEW
  DIAGNOSIS_APPROVED
  BRIEF_GENERATED
  // Talent workflow
  PRESCREENED
  INTERVIEW_SCHEDULED
  APPROVED
  REJECTED
}

enum DataRequestType {
  EXPORT
  DELETE
}

enum DataRequestStatus {
  COMPLETED
  REJECTED
}

model Application {
  id                String            @id @default(cuid())
  type              ApplicationType
  status            ApplicationStatus @default(SUBMITTED)

  // Common fields
  name              String
  email             String
  notes             String?           @db.Text
  privacyAcceptedAt DateTime?
  termsAcceptedAt   DateTime?
  noticeVersion     String?

  // Company — mandatory
  companyName       String?
  companyWebsite    String?
  companyStage      String?
  needArea          String?
  targetMarkets     String?
  engagementModel   String?
  budgetRange       String?
  urgency           String?

  // Company — optional (improve AI diagnosis quality)
  salesMotion       String?
  teamStructure     String?           @db.Text
  hasDeck           Boolean?
  hasDemo           Boolean?
  hasCrm            Boolean?
  previousAttempts  String?           @db.Text
  idealOutcome90d   String?           @db.Text
  specificTargets   String?           @db.Text

  // Talent — profile
  location          String?
  talentCategory    String?
  currentRole       String?
  currentEmployer   String?
  employmentStatus  EmploymentStatus?
  yearsExperience   Int?
  seniorityLevel    SeniorityLevel?
  seniority         String?           // legacy free-text, kept for backwards compat

  // Talent — track record
  engagementPref    String?
  markets           String?
  dealHistory       Json?             // Array of { company, dealSizeRange, geography, outcome, role }
  confidenceMarkets Json?             // Array of { market, confidence: STRONG|MODERATE|LIGHT }
  languagesSpoken   String[]

  // Talent — references
  linkedInUrl       String?
  references        Json?             // Array of { name, title, company, relationship, email, linkedIn }
  cvFileName        String?
  cvFileUrl         String?

  // Talent — assessment & commercials
  caseStudyResponse String?           @db.Text
  availabilityHours AvailabilityHours?
  earliestStart     DateTime?
  rateExpectationMin Int?
  rateExpectationMax Int?
  rateCurrency      String?           @default("USD")
  preferredStructures String[]

  // Signup flow control — free signup with optional completion
  assessmentSkipped   Boolean           @default(false)
  referencesSkipped   Boolean           @default(false)
  assessmentCompletedAt DateTime?
  referencesCompletedAt DateTime?
  matchingUnlocked    Boolean           @default(false)
  matchingUnlockedAt  DateTime?

  // Payment
  paymentProvider   PaymentProvider?
  feeAmountMinor    Int               @default(0) // paisa for INR, cents for USD
  feeCurrency       String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  stripeSessionId   String?           @unique
  stripePaymentId   String?
  paidAt            DateTime?

  // Legacy (kept for backwards compat)
  feeAmountUsd      Int               @default(0)

  // Admin decision fields (T3.13: schedule-interview / approve / reject)
  interviewScheduledAt   DateTime?
  interviewLocation      String?
  interviewNotes         String?  @db.Text
  decidedAt              DateTime?
  decisionReason         String?  @db.Text

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations to AI workflow models
  needDiagnosis     NeedDiagnosis?
  opportunityBrief  OpportunityBrief?
  talentPreScreen   TalentPreScreen?

  @@index([email])
  @@index([status])
  @@map("applications")
}

model DataSubjectRequest {
  id           String            @id @default(cuid())
  type         DataRequestType
  status       DataRequestStatus @default(COMPLETED)
  subjectEmail String
  subjectUserId String?
  requestedBy  String
  reason       String?           @db.Text
  notes        String?           @db.Text
  metadata     Json?
  createdAt    DateTime          @default(now())
  completedAt  DateTime?

  @@index([subjectEmail])
  @@index([requestedBy])
  @@map("data_subject_requests")
}

// ── AI Workflow: Need Diagnosis (company) ─────────────────────────

model NeedDiagnosis {
  id                  String          @id @default(cuid())
  applicationId       String          @unique
  status              DiagnosisStatus @default(DRAFT_AI)
  aiContent           Json            // Structured diagnosis from GPT
  humanEditedContent  Json?           // Admin-edited version
  clientFacingContent Json?           // Simplified version sent to company
  reviewerNotes       String?         @db.Text
  revisionNotes       String?         @db.Text
  aiModel             String?
  promptVersion       String?
  generatedAt         DateTime        @default(now())
  finalizedAt         DateTime?
  clientApprovedAt    DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("need_diagnoses")
}

// ── AI Workflow: Opportunity Brief (company, post-approval) ────────

model OpportunityBrief {
  id                  String   @id @default(cuid())
  applicationId       String   @unique
  internalContent     Json     // Full brief for matching + admin
  clientFacingContent Json     // Simplified version shown to company
  suggestedTemplateId String?  // FK to SowTemplate (soft ref, not enforced)
  aiModel             String?
  promptVersion       String?
  generatedAt         DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("opportunity_briefs")
}

// ── AI Workflow: Talent Pre-Screen ────────────────────────────────

model TalentPreScreen {
  id                    String                  @id @default(cuid())
  applicationId         String                  @unique
  recommendation        PreScreenRecommendation
  completenessScore     Int                     // 0-100
  consistencyScore      Int                     // 0-100
  referenceScore        Int                     // 0-100
  assessmentScore       Int                     // 0-100
  redFlags              Json                    // Array of { type, description, severity }
  suggestedProbeQuestions Json                  // Array of strings
  linkedinVerification  Json?                   // { verified, confidence, source }
  referenceVerification Json?                   // Array of { email, verified, confidence }
  aiModel               String?
  promptVersion         String?
  generatedAt           DateTime                @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("talent_pre_screens")
}

// ── SoW Templates ─────────────────────────────────────────────────

model SowTemplate {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  templateType     SowTemplateType
  version          Int             @default(1)
  description      String          @db.Text
  contentPlainText String          @db.Text
  placeholders     Json            // Array of { name, description, required }
  durationDays     Int
  suggestedFeeMin  Int             // in USD cents
  suggestedFeeMax  Int             // in USD cents
  currency         String          @default("USD")
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("sow_templates")
}

// ── Equity Grants (HYBRID_EQUITY engagements) ──────────────────────

model EquityGrant {
  id               String            @id @default(cuid())
  contractId       String            @unique
  equityType       EquityType        @default(FAST)
  equityPct        Float?            // % for DIRECT grants
  fastValueUsd     Int?              // Notional FAST value in USD cents
  vestingStartDate DateTime?         // Set when PENDING → ACTIVE
  cliffMonths      Int               @default(6)  // Cliff before any equity vests
  vestingMonths    Int               @default(36) // Total vesting period
  status           EquityGrantStatus @default(PENDING)
  vestedPct        Float             @default(0)  // 0–100; updated on each vest event
  lastEventAt      DateTime?         // Timestamp of last status/vest change
  notes            String?           @db.Text     // Admin notes (acceleration reason, lapse reason, etc.)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("equity_grants")
}

model ServiceTemplate {
  id               String              @id @default(cuid())
  code             ServiceTemplateCode @unique
  name             String
  lane             ServiceLane
  engagementType   EngagementType
  retainerFlavour  RetainerFlavour?
  suggestedDurationDays Int?
  description      String              @db.Text
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  roleCombinations RoleTemplateEngagementCombination[]

  @@index([lane])
  @@index([engagementType])
  @@map("service_templates")
}

model RoleTemplateEngagementCombination {
  id              String              @id @default(cuid())
  operatorRole    OperatorRole
  serviceTemplate ServiceTemplateCode
  engagementType  EngagementType
  retainerFlavour RetainerFlavour?
  serviceLane     ServiceLane
  isRecommended   Boolean             @default(true)
  notes           String?
  createdAt       DateTime            @default(now())

  template ServiceTemplate @relation(fields: [serviceTemplate], references: [code], onDelete: Cascade)

  @@unique([operatorRole, serviceTemplate, engagementType, retainerFlavour])
  @@index([operatorRole])
  @@index([serviceTemplate, engagementType, retainerFlavour])
  @@map("role_template_engagement_combinations")
}
