// This file is the entry point for prisma/schema.prisma.
// Core entity models will be progressively added in Artifact 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum OrgType {
  STARTUP
  OPERATOR_ENTITY
  PLATFORM
}

enum MembershipRole {
  STARTUP_ADMIN
  STARTUP_MEMBER
  OPERATOR
  PLATFORM_ADMIN
  DEAL_DESK
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum OnboardingStage {
  ONBOARDING
  PENDING_APPROVAL
  ACTIVE
}

enum AuthProvider {
  GOOGLE
  MICROSOFT
  APPLE
}

enum EmailActionType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ─────────────────────────────────────────────
// CORE IDENTITY MODELS (Artifact 2)
// ─────────────────────────────────────────────

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  passwordHash     String?      // nullable — users created via magic-link have no password initially
  status           UserStatus   @default(ACTIVE)
  lastLoginAt      DateTime?
  // Magic-link auth
  emailVerifiedAt  DateTime?
  privacyAcceptedAt DateTime?
  termsAcceptedAt   DateTime?
  noticeVersion     String?
  onboardingStage  OnboardingStage @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  memberships       Membership[]
  authIdentities    OAuthIdentity[]
  emailActionTokens EmailActionToken[]
  notes             WorkspaceNote[]
  activityLogs      ActivityLog[]
  nudges            SystemNudge[]
  escalations       EscalationCase[]
  ratingsGiven      EngagementRating[] @relation("RatingReviewer")
  ratingsReceived   EngagementRating[] @relation("RatingReviewee")

  @@index([email])
  @@index([onboardingStage])
  @@map("users")
}

model OAuthIdentity {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_identities")
}

model EmailActionToken {
  id         String          @id @default(cuid())
  userId     String?
  email      String
  tokenHash  String          @unique
  type       EmailActionType
  metadata   Json?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([expiresAt])
  @@map("email_action_tokens")
}

model Organization {
  id        String   @id @default(cuid())
  orgType   OrgType
  name      String
  country   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  startupProfile   StartupProfile?
  operatorProfile  OperatorProfile?

  @@map("organizations")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  orgId          String
  membershipRole MembershipRole
  status         MembershipStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@map("memberships")
}

// ─────────────────────────────────────────────
// STARTUP INTAKE MODELS (Artifact 3)
// ─────────────────────────────────────────────

enum StartupStage {
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B_PLUS
  BOOTSTRAPPED
}

enum SalesMotion {
  OUTBOUND
  INBOUND
  PARTNER_LED
  PRODUCT_LED
  BLENDED
}

enum BudgetBand {
  UNDER_2K
  TWO_TO_5K
  FIVE_TO_10K
  ABOVE_10K
}

enum TargetMarket {
  EU
  US
  AU
  REST_OF_WORLD
}

enum ProfileStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum Eligibility {
  INELIGIBLE
  SPRINT_ONLY
  SPRINT_AND_RETAINER
}

model StartupProfile {
  id                   String        @id @default(cuid())
  startupId            String        @unique
  industry             String
  stage                StartupStage
  targetMarkets        TargetMarket[]
  salesMotion          SalesMotion
  budgetBand           BudgetBand
  executionOwner       String?
  hasProductDemo       Boolean       @default(false)
  hasDeck              Boolean       @default(false)
  toolingReady         Boolean       @default(false)
  responsivenessCommit Boolean       @default(false)
  additionalContext    String?
  status               ProfileStatus @default(DRAFT)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  startup        Organization         @relation(fields: [startupId], references: [id], onDelete: Cascade)
  scores         DemandReadinessScore[]
  discoveryCalls DiscoveryCall[]
  shortlists     MatchShortlist[]
  engagements    Engagement[]
  masterServiceAgreements MasterServiceAgreement[]
  engagementCalls EngagementCall[]
  preSowSummaries PreSowCommercialSummary[]

  @@map("startup_profiles")
}

model DemandReadinessScore {
  id             String      @id @default(cuid())
  profileId      String
  scoreTotal     Int
  scoreBreakdown Json
  blockers       String[]
  recommendation String?
  eligibility    Eligibility
  generatedBy    String      @default("AI")
  promptVersion  String?
  modelName      String?
  temperature    Float?
  adminOverride  Boolean     @default(false)
  overrideReason String?
  createdAt      DateTime    @default(now())

  profile StartupProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("demand_readiness_scores")
}

// ─────────────────────────────────────────────
// OPERATOR & INVITE MODELS (Artifact 4)
// ─────────────────────────────────────────────

enum OperatorLane {
  PIPELINE_SPRINT
  BD_SPRINT
  FRACTIONAL_RETAINER
  HYBRID_EQUITY
}

enum OperatorTier {
  TIER_A
  TIER_B
  TIER_C
  UNVERIFIED
}

enum OperatorVerification {
  PENDING
  VERIFIED
  REJECTED
}

enum InviteStatus {
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ServiceLane {
  FRACTIONAL_LEADERSHIP
  FRACTIONAL_BD_PARTNERSHIPS
  FRACTIONAL_EXECUTION_OPS
}

enum EngagementType {
  CONSULTATION
  SPRINT
  RETAINER
}

enum RetainerFlavour {
  LEADERSHIP
  OPERATOR
}

enum ServiceTemplateCode {
  INTL_MARKET_ENTRY
  ICP_REFINEMENT
  GTM_STRATEGY
  PIPELINE_SPRINT
  FOUNDER_LED_SALES_TRANSITION
  REVENUE_CADENCE_SETUP
  PARTNER_CHANNEL_DEVELOPMENT
  CUSTOMER_SUCCESS_RETENTION
  SALES_PROCESS_CRM_CLEANUP
  CLOSING_SUPPORT
}

enum OperatorRole {
  VP_SALES
  VP_REVENUE
  CRO
  HEAD_OF_SALES
  GTM_LEADER
  FOUNDER_LED_SALES_COACH
  REVENUE_ADVISOR
  BD_LEAD
  PARTNERSHIPS_LEAD
  CHANNEL_LEAD
  ALLIANCES_LEAD
  MARKET_ACCESS_LEAD
  AE
  SDR
  BDR
  OUTBOUND_OPERATOR
  REVOPS
  SALES_OPS
  CUSTOMER_SUCCESS_OPERATOR
  EXPANSION_OPERATOR
  ACCOUNT_MANAGER
  SALES_ENABLEMENT_SOLUTIONS_CONSULTANT
}

model InviteToken {
  id          String       @id @default(cuid())
  email       String
  token       String       @unique
  role        MembershipRole
  orgName     String?
  status      InviteStatus @default(SENT)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  @@index([token])
  @@index([email])
  @@map("invite_tokens")
}

model OperatorProfile {
  id                String              @id @default(cuid())
  operatorId        String              @unique
  lanes             OperatorLane[]
  roles             OperatorRole[] @default([])
  regions           TargetMarket[]
  functions         String[]
  experienceTags    String[]
  yearsExperience   Int?
  linkedIn          String?
  references        Json?
  availability      String?
  bio               String?
  openToEquity      Boolean             @default(false)   // Opt-in to HYBRID_EQUITY matching
  verification      OperatorVerification @default(PENDING)
  tier              OperatorTier         @default(UNVERIFIED)

  // ── Phase 6 partner credential pointers ─────────────────────────────────
  // Set by Stripe Connect Express onboarding (P6.2). Used as the destination
  // account for ACH payouts.
  stripeAccountId        String?
  stripeChargesEnabled   Boolean?
  stripePayoutsEnabled   Boolean?
  stripeDetailsSubmitted Boolean?

  // Set by Wise recipient creation (P6.4). Identifies the operator's bank
  // account on Wise's side for cross-border payouts.
  wiseRecipientId   String?

  // Set by RazorpayX fund-account creation (P6.3). Identifies the operator's
  // Indian bank account as a payout destination from BridgeScale's RazorpayX
  // account_number.
  razorpayFundAccountId String?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  operator Organization           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  scores   SupplyQualityScore[]
  candidates MatchCandidate[]
  engagements Engagement[]
  masterServiceAgreements MasterServiceAgreement[]
  taxProfiles OperatorTaxProfile[]
  eorEnrollments OperatorEorEnrollment[]
  complianceDecisionLogs ComplianceDecisionLog[]
  engagementCalls EngagementCall[]
  preSowSummaries PreSowCommercialSummary[]

  @@map("operator_profiles")
}

model SupplyQualityScore {
  id             String       @id @default(cuid())
  profileId      String
  scoreTotal     Int
  scoreBreakdown Json
  blockers       String[]
  recommendation String?
  tier           OperatorTier
  generatedBy    String       @default("AI")
  promptVersion  String?
  modelName      String?
  temperature    Float?
  adminOverride  Boolean      @default(false)
  overrideReason String?
  createdAt      DateTime     @default(now())

  profile OperatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("supply_quality_scores")
}

// ─────────────────────────────────────────────
// DISCOVERY & PACKAGE MODELS (Artifact 5)
// ─────────────────────────────────────────────

enum DiscoveryStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PackageType {
  PIPELINE_SPRINT
  BD_SPRINT
  FRACTIONAL_RETAINER
  HYBRID_EQUITY
}

model DiscoveryCall {
  id                String           @id @default(cuid())
  startupProfileId  String
  scheduledAt       DateTime
  durationMinutes   Int              @default(30)
  meetingLink       String?
  status            DiscoveryStatus  @default(SCHEDULED)
  notes             String?
  aiSummary         String?
  aiRecommendation  String?
  recommendedPkgs   PackageType[]
  promptVersion     String?
  modelName         String?
  adminOverride     Boolean          @default(false)
  overrideSummary   String?
  overrideReason    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  startupProfile    StartupProfile   @relation(fields: [startupProfileId], references: [id], onDelete: Cascade)

  @@index([startupProfileId])
  @@index([scheduledAt])
  @@map("discovery_calls")
}

model Package {
  id            String      @id @default(cuid())
  type          PackageType
  name          String
  description   String?
  durationWeeks Int
  weeklyHours   Int
  priceUsd      Int
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@map("packages")
}

// ─────────────────────────────────────────────
// MATCHING & SHORTLIST MODELS (Artifact 6)
// ─────────────────────────────────────────────

enum ShortlistStatus {
  DRAFT
  PUBLISHED
  SELECTION_MADE
  EXPIRED
}

enum CandidateStatus {
  SHORTLISTED
  INTERESTED
  DECLINED
  SELECTED
  PASSED
}

enum CandidateInterest {
  PENDING
  ACCEPTED
  DECLINED
}

model MatchShortlist {
  id                String           @id @default(cuid())
  startupProfileId  String
  generatedBy       String           @default("AI")
  status            ShortlistStatus  @default(DRAFT)
  publishedAt       DateTime?
  selectionDeadline DateTime?
  promptVersion     String?
  modelName         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  startupProfile    StartupProfile   @relation(fields: [startupProfileId], references: [id], onDelete: Cascade)
  candidates        MatchCandidate[]

  @@index([startupProfileId])
  @@map("match_shortlists")
}

model MatchCandidate {
  id               String             @id @default(cuid())
  shortlistId      String
  operatorId       String
  matchScore       Int
  scoreBreakdown   Json
  explanation      String?
  mainRisk         String?
  packageTier      PackageType?
  weeklyFitHours   Int?
  status           CandidateStatus    @default(SHORTLISTED)
  interest         CandidateInterest  @default(PENDING)
  declineReason    String?
  selectedAt       DateTime?
  createdAt        DateTime           @default(now())

  shortlist MatchShortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  operator  OperatorProfile @relation(fields: [operatorId], references: [operatorId], onDelete: Cascade)

  @@unique([shortlistId, operatorId])
  @@index([shortlistId])
  @@index([operatorId])
  @@map("match_candidates")
}

// ─────────────────────────────────────────────
// SOW, CONTRACT & E-SIGNATURE MODELS (Artifact 7)
// ─────────────────────────────────────────────

enum SowStatus {
  AI_DRAFT
  DRAFT
  REVIEW
  HUMAN_APPROVED
  SHARED
  APPROVED
  SIGNED
  ACTIVE
  COMPLETED
  TERMINATED
  LOCKED
}

enum ContractStatus {
  PENDING_SIGNATURES
  STARTUP_SIGNED
  OPERATOR_SIGNED
  FULLY_SIGNED
  CANCELLED
}

model StatementOfWork {
  id                String       @id @default(cuid())
  shortlistId       String
  startupProfileId  String
  operatorId        String
  masterAgreementId String?
  packageType       PackageType
  serviceTemplate   ServiceTemplateCode?
  engagementType    EngagementType?
  retainerFlavour   RetainerFlavour?
  title             String
  scope             String
  deliverables      String
  timeline          String
  weeklyHours       Int
  totalPriceUsd     Int
  nonCircumvention  Boolean      @default(true)

  // ── Equity fields (set only when packageType = HYBRID_EQUITY) ──────────────
  equityCashComponentUsd   Int?        // Monthly cash retainer in USD cents
  equityType               EquityType? // FAST or DIRECT
  equityPct                Float?      // % of company equity — DIRECT only
  fastValueUsd             Int?        // FAST notional value in USD cents — FAST only
  vestingSchedule          String?     // Human-readable schedule (e.g. "6-month cliff, monthly")
  equityCliffMonths        Int?        // Cliff period in months
  equityVestingMonths      Int?        // Total vesting duration in months
  equityKpiMilestones      Json?       // Array of { metric, target, bonusDescription }
  startupLegalAck          Boolean     @default(false) // Startup side equity legal acknowledgment
  operatorLegalAck         Boolean     @default(false) // Operator side equity legal acknowledgment
  equityReviewRequired     Boolean     @default(false) // Admin review gate (auto or manually triggered)
  equityReviewApprovedAt   DateTime?   // Set by admin when review passes

  status            SowStatus    @default(DRAFT)
  currentVersion    Int          @default(1)
  promptVersion     String?
  modelName         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  versions  SowVersion[]
  contract  Contract?
  msa       MasterServiceAgreement? @relation(fields: [masterAgreementId], references: [id])
  hybridAddendum HybridAddendum?
  successFeeAddendum SuccessFeeAddendum?
  equityOnlyAddendum EquityOnlyAddendum?
  conversionAddendum ConversionAddendum?
  cancellationEvents CancellationEvent[]

  @@index([startupProfileId])
  @@index([operatorId])
  @@index([masterAgreementId])
  @@index([serviceTemplate, engagementType, retainerFlavour])
  @@map("statements_of_work")
}

enum MsaStatus {
  PENDING_SIGNATURES
  PARTIALLY_SIGNED
  FULLY_EXECUTED
  TERMINATED
}

model MasterServiceAgreement {
  id                   String    @id @default(cuid())
  startupProfileId     String
  operatorId           String
  status               MsaStatus @default(PENDING_SIGNATURES)
  platformFeePercent   Int       @default(10)
  conversionFeePercent Int       @default(25)
  nonCircMonths        Int       @default(12)
  termNoticeDays       Int       @default(30)
  governingLaw         String    @default("India")
  platformSignedAt     DateTime?
  startupSignedAt      DateTime?
  operatorSignedAt     DateTime?
  platformSignatureId  String?
  startupSignatureId   String?
  operatorSignatureId  String?
  fullyExecutedAt      DateTime?
  documentUrl          String?
  watermarked          Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  startup StartupProfile @relation(fields: [startupProfileId], references: [id], onDelete: Cascade)
  operator OperatorProfile @relation(fields: [operatorId], references: [operatorId], onDelete: Cascade)
  sows StatementOfWork[]
  preSowSummaries PreSowCommercialSummary[]

  @@unique([startupProfileId, operatorId])
  @@index([operatorId])
  @@map("master_service_agreements")
}

model SowVersion {
  id          String   @id @default(cuid())
  sowId       String
  version     Int
  content     Json
  changedBy   String
  changeNote  String?
  createdAt   DateTime @default(now())

  sow StatementOfWork @relation(fields: [sowId], references: [id], onDelete: Cascade)

  @@unique([sowId, version])
  @@map("sow_versions")
}

model Contract {
  id                  String          @id @default(cuid())
  sowId               String          @unique
  status              ContractStatus  @default(PENDING_SIGNATURES)
  startupSignedAt     DateTime?
  operatorSignedAt    DateTime?
  startupSignatureId  String?
  operatorSignatureId String?
  fullySignedAt       DateTime?
  contactsUnlocked    Boolean         @default(false)
  watermarked         Boolean         @default(true)
  idempotencyKey      String?         @unique
  // Equity — set when SOW packageType = HYBRID_EQUITY
  hasEquityComponent  Boolean         @default(false)
  equityDocumentRef   String?         // External URL: FAST agreement or equity side-letter
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sow           StatementOfWork @relation(fields: [sowId], references: [id], onDelete: Cascade)
  documentLogs  DocumentLog[]
  paymentPlan   PaymentPlan?
  paymentLedgers PaymentLedger[]
  engagement    Engagement?
  equityGrant   EquityGrant?

  @@map("contracts")
}

model DocumentLog {
  id          String   @id @default(cuid())
  contractId  String
  action      String
  performedBy String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("document_logs")
}

// ─────────────────────────────────────────────
// PAYMENTS & INVOICING MODELS (Artifact 8)
// ─────────────────────────────────────────────

enum PaymentPlanType {
  CASH_SPRINT_FEE
  MONTHLY_RETAINER
  SUCCESS_FEE_ADDENDUM
  HYBRID_CASH_EQUITY
  EQUITY_ONLY
  CONVERSION_FEE
  MILESTONE_SCHEDULE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentEventStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentLedgerStatus {
  DRAFT
  REVIEWED
  APPROVED
  BLOCKED
  READY_FOR_PAYOUT
}

enum PayoutProvider {
  STRIPE_CONNECT
  RAZORPAY
  WISE
  MANUAL
  DUMMY
}

enum PayoutAttemptStatus {
  PLANNED
  QUEUED
  SUCCEEDED
  FAILED
  CANCELLED
}

model PaymentPlan {
  id              String          @id @default(cuid())
  contractId      String          @unique
  planType        PaymentPlanType
  totalAmountUsd  Int
  currency        String          @default("USD")
  billingCurrency String          @default("USD")
  payoutCurrency  String?
  fxRateAtSigning Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  ledger PaymentLedger?

  @@map("payment_plans")
}

model PaymentLedger {
  id                  String              @id @default(cuid())
  paymentPlanId       String              @unique
  contractId          String
  invoiceAmount       Int
  billingCurrency     String              @default("USD")
  platformFeeAmount   Int
  operatorPayoutAmount Int
  eorFeeAmount        Int                 @default(0)
  payoutCurrency      String?
  fxRateAtSigning     Float?
  complianceMode      ComplianceMode      @default(UNKNOWN)
  taxReady            Boolean             @default(false)
  payoutReady         Boolean             @default(false)
  status              PaymentLedgerStatus @default(DRAFT)
  reviewNotes         String?             @db.Text
  reviewedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  payoutAttempts PayoutAttempt[]

  @@index([contractId])
  @@index([status])
  @@map("payment_ledgers")
}

model PayoutAttempt {
  id              String              @id @default(cuid())
  ledgerId        String
  provider        PayoutProvider
  status          PayoutAttemptStatus @default(PLANNED)
  amount          Int
  currency        String
  providerRef     String?
  dummyMode       Boolean             @default(true)
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  ledger PaymentLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId])
  @@index([provider])
  @@map("payout_attempts")
}

model Invoice {
  id             String        @id @default(cuid())
  paymentPlanId  String
  amountUsd      Int
  description    String
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  stripeUrl      String?       @db.Text
  stripeId       String?       @unique
  metadata       Json?
  issuedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  paymentPlan PaymentPlan    @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  events      PaymentEvent[]

  @@index([paymentPlanId])
  @@index([status])
  @@map("invoices")
}

model PaymentEvent {
  id              String             @id @default(cuid())
  invoiceId       String
  stripeEventId   String             @unique
  amountCaptured  Int
  status          PaymentEventStatus
  errorMessage    String?
  createdAt       DateTime           @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment_events")
}

enum TaxFormType {
  W9
  W8BEN
  W8BEN_E
  GST_PAN
  VAT
  OTHER
}

enum TaxFormStatus {
  NOT_STARTED
  COLLECTED
  UNDER_REVIEW
  VERIFIED
  EXPIRED
  REJECTED
}

enum CompensationMode {
  CASH
  SUCCESS_FEE
  HYBRID_CASH_EQUITY
  EQUITY_ONLY
  CONVERSION_FEE
}

enum ComplianceMode {
  CONTRACTOR
  CONTRACTOR_WITH_REVIEW
  EOR_REQUIRED
  AGENCY_OF_RECORD
  PAYROLL_REQUIRED
  BLOCKED_PENDING_REVIEW
  UNKNOWN
}

enum EorPartner {
  DEEL
  REMOTE
  MULTIPLIER
}

enum EorEnrollmentStatus {
  NOT_STARTED
  PENDING
  ACTIVE
  REJECTED
  TERMINATED
}

enum CancellationParty {
  STARTUP
  OPERATOR
  PLATFORM
}

enum LifecycleEventType {
  CREATED
  STATUS_CHANGED
  CONVERSION_CANDIDATE
  CONVERTED_TO_FULLTIME
  PAYMENT_MILESTONE
  CLOSEOUT
}

enum EngagementCallStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

