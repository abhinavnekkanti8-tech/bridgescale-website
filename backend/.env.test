# ── Test environment — safe to commit ────────────────────────────────────────
# This file is loaded by Jest when running `npm test`.
# It forces all AI calls into mock/deterministic mode so tests never
# hit a live OpenAI API and never require a valid API key.
#
# DUMMY_AI_MODE=true
#   Triggers the mock path in AiService for ALL AI features:
#     - generateOpportunityBrief  → mockOpportunityBrief()
#     - generateTalentPreScreen   → mockTalentPreScreen()
#     - generateNeedsDiagnosis    → mockNeedDiagnosis()
#     - scoreStartupReadiness     → buildMockResponse()
#
# To run tests against a real OpenAI key, remove DUMMY_AI_MODE or set it
# to false, and provide a valid OPENAI_API_KEY.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://test:test@localhost:5432/platform_test
SESSION_SECRET=test-session-secret-not-for-production

# AI — always mock in tests
OPENAI_API_KEY=sk-dummy-test-key
DUMMY_AI_MODE=true

# Payments — dummy mode in tests
DUMMY_PAYMENT_MODE=true

# Cross-verification — dummy mode in tests
CROSS_VERIFY_MODE=dummy
